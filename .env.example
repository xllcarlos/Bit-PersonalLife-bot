# ==========================================
# Routine AI Bot - variáveis de ambiente
# (configure na Vercel: Settings > Environment Variables)
# ==========================================

# 1. Telegram
TELEGRAM_BOT_TOKEN=""
ALLOWED_TELEGRAM_USER_ID=""
TELEGRAM_SECRET_TOKEN=""

# 2. Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_FALLBACK_MODELS=""

# 3. Google Calendar (Service Account)
GOOGLE_CLIENT_EMAIL="seu-bot@seu-projeto.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_CALENDAR_ID="seu-email@gmail.com"
GOOGLE_EXTRA_CALENDAR_IDS=""

# 4. Notion (Tabela Task Manager)
# Token da integração (https://www.notion.so/my-integrations)
NOTION_API_KEY=""
# ID de 32 caracteres da tabela Task Manager
NOTION_TASK_DATABASE_ID=""
# Nomes exatos das colunas (já configurados conforme sua tabela atual):
NOTION_TITLE_PROPERTY="Nome da tarefa"
NOTION_DATE_PROPERTY="Prazo"
NOTION_STATUS_PROPERTY="Status"
NOTION_DONE_STATUS="Concluído"

# 5. Redis (Upstash)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
