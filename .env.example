# ==========================================
# Routine AI Bot - variáveis de ambiente
# (configure na Vercel: Settings > Environment Variables)
# ==========================================

# 1. Telegram
# Token do @BotFather
TELEGRAM_BOT_TOKEN=""
# Seu ID numérico (@userinfobot). OBRIGATÓRIO: sem ele o bot recusa todo mundo.
ALLOWED_TELEGRAM_USER_ID=""
# Segredo aleatório e longo. OBRIGATÓRIO: protege o webhook e o /api/setup-webhook.
TELEGRAM_SECRET_TOKEN=""

# 2. Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.8-flash"
# Opcional e vazio por padrão (hoje só o gemini-3.8-flash existe). Separados por vírgula.
GEMINI_FALLBACK_MODELS=""

# 3. Google Calendar (Service Account)
GOOGLE_CLIENT_EMAIL="seu-bot@seu-projeto.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Agenda principal (leitura e escrita): normalmente seu e-mail.
GOOGLE_CALENDAR_ID="seu-email@gmail.com"
# Opcional: agendas extras SOMENTE LEITURA, separadas por vírgula (ex: Família, Feriados).
# Compartilhe cada uma com o e-mail da Service Account e cole o ID aqui.
GOOGLE_EXTRA_CALENDAR_IDS=""

# 4. Redis (Upstash) - guarda propostas pendentes e o contexto da conversa.
# Na Vercel: Storage > Marketplace > Upstash Redis (free). As variáveis KV_REST_API_URL e
# KV_REST_API_TOKEN são preenchidas sozinhas; os nomes UPSTASH_REDIS_REST_* também funcionam.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
